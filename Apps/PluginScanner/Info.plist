<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Embedded into the PluginScanner executable's __TEXT,__info_plist section (see
    CMakeLists.txt). A bare console binary has no bundle, so this is the only Info
    dictionary macOS sees for it, and LSUIElement keeps the process and every
    worker it spawns off the Dock from the first frame.
-->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.makeasound.pluginscanner</string>
    <key>CFBundleName</key>
    <string>PluginScanner</string>
    <key>CFBundleExecutable</key>
    <string>PluginScanner</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSUIElement</key>
    <true/>
</dict>
</plist>
